{
  "manifest_version": 3,
  "name": "Site Notes",
  "version": "1.0.0",
  "description": "Attach a note to any webpage. Notes are saved per URL and sync across devices.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_title": "Open / Close Site Notes",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Open / Close the Site Notes sidebar"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
